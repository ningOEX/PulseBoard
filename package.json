{
  "name": "panel-chat",
  "version": "1.0.0",
  "private": true,
  "description": "实时协作数据看板",
  "scripts": {
    "install:all": "npm install --prefix server && npm install --prefix web",
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev --prefix server",
    "dev:web": "npm run dev --prefix web",
    "build": "npm run build --prefix web && npm run build --prefix server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
